<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog surface. Referenced by NexusDialog (see nexus_styles.xml), which
     is wired into FixTheme via android:alertDialogTheme + android:dialogTheme
     so every AlertDialog in the app picks it up without touching call sites. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/nexus_divider" />
    <corners android:radius="16dp" />
</shape>