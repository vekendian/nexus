<?xml version="1.0" encoding="utf-8"?>
<!--
  Dialog surface. NOT referenced from the theme any more: android/ext/f.smali
  method t() installs this on the dialog Window in code, which is the only
  path that every GameGuardian dialog actually takes (46 of 46 creation
  sites funnel through android/ext/f). The theme item never reached the
  button bar, and a code-set drawable keeps the corner radius density-aware.

  The fill is nexus_surface_high and the hairline is nexus_surface_alt, which
  is the reference app's dialog surface. A hairline is what separates a
  dialog from a bright game frame behind it: at the framework's default 0.6
  dim the backdrop is close enough to the surface that a flat panel reads as
  a hole. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_surface_high" />
    <stroke android:width="1dp" android:color="@color/nexus_surface_alt" />
    <corners android:radius="28dp" />
</shape>
