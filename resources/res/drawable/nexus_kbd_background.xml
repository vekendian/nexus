<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus replacement for GameGuardian's keyboard_background_lxx_dark, which is
     only shipped as five density-specific 9-patch PNGs. Pointing the layout at
     this drawable bypasses all of them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_bg" />
    <corners android:radius="12dp" />
</shape>
