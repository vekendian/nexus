<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled primary action for the dialog button bar.

  Material dark themes give the primary action a filled button and leave the
  secondary actions as plain text, which is what creates hierarchy. Before
  this, every dialog action was identical borderless text and read flat.

  The radius is 16dp, the same as the tonal button, and the ripple is the
  reference app's: a primary action that swallows the tap is a primary
  action that feels broken.

  Installed in code by android/ext/f.smali method t() via
  Button.setBackgroundResource, so unlike nexus_bg_dialog this one is
  referenced by a raw constant in smali and therefore DOES need a pinned id
  in nexus_ids.json. Paired with nexus_on_orange, already defined for
  exactly this pairing. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_orange" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_orange" />
            <stroke android:width="2dp" android:color="@color/nexus_on_orange" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_orange" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>