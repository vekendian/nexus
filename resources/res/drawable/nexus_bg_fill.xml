<?xml version="1.0" encoding="utf-8"?>
<!--
  The fill of a progress bar: 3dp rounded, matching nexus_bg_track.

  Ported from the reference app, which had the pair and the patcher did not.
  A stock ProgressBar is a square-ended rectangle, and a rounded one is the
  difference between "a bar" and "a rectangle somebody filled in".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_orange"/>
    <corners android:radius="3dp"/>
</shape>
