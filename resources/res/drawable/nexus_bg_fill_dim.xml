<?xml version="1.0" encoding="utf-8"?>
<!--
  The dimmer fill of the float's second progress bar.

  The first bar is the scan's own progress; the second is the stage behind
  it. Two tones of the same hue say "one is further along than the other"
  without needing a second colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_orange_dim" />
    <corners android:radius="3dp" />
</shape>
