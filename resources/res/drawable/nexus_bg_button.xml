<?xml version="1.0" encoding="utf-8"?>
<!--
  The global button.

  One answer to "what does a button look like", applied to every surface:
  a Nexus button is the orange pill with the app's white label. GameGuardian's
  dialogs, editor bars, goto chips and installer screen all carry it now: the
  theme's android:buttonStyle is this surface for buttons built in code, and
  transform_gg_surface writes it into every android.fix.Button layout puts on
  screen. Enabled is the accent; disabled keeps the pill shape in the surface
  the app uses for every other off-state control, so a button the app disables
  reads as off without leaving the language.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nexus_surface_alt" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nexus_orange" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
