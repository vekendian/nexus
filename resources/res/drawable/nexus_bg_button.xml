<?xml version="1.0" encoding="utf-8"?>
<!-- Background for buttons that live INSIDE dialog content (android.fix.Button),
     as opposed to the dialog's own positive/negative/neutral button bar which
     uses NexusDialogButton. Fill matches nexus_kbd_key_normal so keys and dialog
     buttons share one interaction colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_surface_alt" />
    <stroke
        android:width="1dp"
        android:color="@color/nexus_divider" />
    <corners android:radius="10dp" />
</shape>