<?xml version="1.0" encoding="utf-8"?>
<!--
  The ripple for a row: no fill, so it can be layered over whatever surface
  the row is on. Ported from the reference app.

  Rows in GameGuardian's own layouts get this as their background, with the
  surface underneath supplied by the layout.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</ripple>
