<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus-styled counter/badge background.
  
  Replaces GameGuardian's counter.9.png (purple glow 9-patch).
  Rounded pill shape with Nexus orange fill and subtle edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nexus_orange" />
    <stroke android:width="1dp" android:color="@color/nexus_float_badge_edge" />
    <corners android:radius="16dp" />
</shape>
